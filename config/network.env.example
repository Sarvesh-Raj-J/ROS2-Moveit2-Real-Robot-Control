# Copy to a local .env-like file and replace with your values.
# Use the same ROS_DOMAIN_ID on both laptop and Raspberry Pi.

LAPTOP_IP=192.168.1.10
PI_IP=192.168.1.20
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional Fast DDS profile path if you use a custom XML profile file:
# FASTRTPS_DEFAULT_PROFILES_FILE=$HOME/agropilot2working_ws/fastdds_profiles.xml
